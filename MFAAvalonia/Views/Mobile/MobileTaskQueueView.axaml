<UserControl x:Class="MFAAvalonia.Views.Mobile.MobileTaskQueueView"
             x:DataType="pages:TaskQueueViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:extensions="clr-namespace:MFAAvalonia.Extensions"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
             xmlns:other="clr-namespace:MFAAvalonia.ViewModels.Other"
             xmlns:valueType="clr-namespace:MFAAvalonia.Helper.ValueType"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="760">
    <UserControl.Styles>
        <Style Selector="Ellipse#MobileLiveStatusDot">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.2" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.2" />
                        <Setter Property="Opacity" Value="0.8" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse#MobilePulseRing1, Ellipse#MobilePulseRing2">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="2.5" />
                        <Setter Property="ScaleTransform.ScaleY" Value="2.5" />
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="StrokeThickness" Value="0.5" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse#MobilePulseRing2">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE" Easing="CubicEaseOut" Delay="0:0:0.75">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="2.5" />
                        <Setter Property="ScaleTransform.ScaleY" Value="2.5" />
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="StrokeThickness" Value="0.5" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Margin="12,12,12,10">
        <Border x:Name="PreviewHost" Height="230" CornerRadius="8" ClipToBounds="True"
                SizeChanged="OnPreviewHostSizeChanged"
                Background="#12000000" BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="1">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                    <fluent:FluentIcon Icon="Desktop" IconSize="Size32" Foreground="{DynamicResource SukiLowText}" />
                    <TextBlock x:Name="VirtualDisplayTitle" Text="Virtual display" Foreground="{DynamicResource SukiLowText}" />
                </StackPanel>
                <ContentControl x:Name="NativePreviewHost"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="VirtualDisplayImage" Stretch="Uniform" IsVisible="False" />
                <Border x:Name="VirtualDisplayRunningBadge" IsVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                        Padding="8,5" CornerRadius="5" Background="#C0202020">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="MobilePulseRing1" Width="8" Height="8"
                                     Fill="Transparent" Stroke="{DynamicResource SukiSuccessColor}"
                                     StrokeThickness="2" Opacity="0" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                                <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="MobilePulseRing2" Width="8" Height="8"
                                     Fill="Transparent" Stroke="{DynamicResource SukiSuccessColor}"
                                     StrokeThickness="2" Opacity="0" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                                <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="MobileLiveStatusDot" Width="8" Height="8"
                                     Fill="{DynamicResource SukiSuccessColor}" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                                <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="VirtualDisplayRunningText" Text="Running"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SukiSuccessColor}" />
                    </StackPanel>
                </Border>
                <Border x:Name="VirtualDisplayFpsBadge" IsVisible="False"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                        Padding="8,5" CornerRadius="5" Background="#C0202020">
                    <TextBlock x:Name="VirtualDisplayFpsText" Text="FPS: 0.0"
                               FontSize="11" Foreground="#F0FFFFFF" />
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                        Padding="7" CornerRadius="5" Background="#C0202020">
                    <Grid ColumnDefinitions="150,Auto">
                        <TextBox x:Name="VirtualPackageName" IsVisible="False" Height="36"
                                 Watermark="Target package name" FontSize="12" />
                        <TextBlock x:Name="VirtualDisplayStatus" VerticalAlignment="Center"
                                   Text="Virtual display is stopped" Foreground="#D0FFFFFF" FontSize="10"
                                   Margin="2,0,4,0" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="VirtualDisplayButton" Grid.Column="1" Width="40" Height="36"
                                Margin="6,0,0,0" Padding="0" Click="ToggleVirtualDisplay"
                                ToolTip.Tip="Start or stop virtual display">
                            <fluent:FluentIcon Icon="DesktopSync" IconSize="Size20" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

            <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="2,14,2,0">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="TaskQueueTitle" Text="Task queue" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="TaskQueueDescription" Text="Select tasks to run in the default instance" FontSize="11"
                               Foreground="{DynamicResource SukiLowText}" />
                </StackPanel>
                <Button x:Name="SelectAllButton" Grid.Column="1" Width="42" Height="42" Padding="0"
                        Command="{Binding SelectAllCommand}" ToolTip.Tip="Select all">
                    <fluent:FluentIcon Icon="SelectAllOn" IconSize="Size20" />
                </Button>
            </Grid>
            <ListBox x:Name="TaskList" Grid.Row="1" ItemsSource="{Binding TaskItemViewModels}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="valueType:DragItemViewModel">
                        <Border MinHeight="52" Padding="10,6" Margin="0,0,0,6" CornerRadius="6"
                                Background="{DynamicResource SukiCardBackground}"
                                BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <CheckBox IsThreeState="True" MinWidth="40"
                                          IsEnabled="{Binding !IsResourceOptionItem}"
                                          IsChecked="{Binding IsCheckedWithNull}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RunElapsedText}" FontSize="11"
                                               Foreground="{DynamicResource SukiLowText}"
                                               IsVisible="{Binding IsRunElapsedVisible}" />
                                </StackPanel>
                                <Button Grid.Column="2" Width="36" Height="36" Padding="0"
                                        IsVisible="{Binding !IsResourceOptionItem}"
                                        Click="MoveTaskUp" CommandParameter="{Binding}">
                                    <fluent:FluentIcon Icon="ArrowUp" IconSize="Size20" />
                                </Button>
                                <Button Grid.Column="3" Width="36" Height="36" Padding="0"
                                        IsVisible="{Binding !IsResourceOptionItem}"
                                        Click="MoveTaskDown" CommandParameter="{Binding}">
                                    <fluent:FluentIcon Icon="ArrowDown" IconSize="Size20" />
                                </Button>
                                <Button Grid.Column="4" Width="36" Height="36" Padding="0"
                                        IsVisible="{Binding HasMobileOptions}"
                                        Click="OpenTaskOptions" CommandParameter="{Binding}">
                                    <fluent:FluentIcon Icon="Settings" IconSize="Size20" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid x:Name="OptionHost" Grid.Row="1" RowDefinitions="Auto,*" IsVisible="False">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                    <Button Width="40" Height="40" Padding="0" Click="ShowTasks">
                        <fluent:FluentIcon Icon="ArrowLeft" IconSize="Size20" />
                    </Button>
                    <TextBlock x:Name="OptionTitle" Grid.Column="1" FontSize="16" FontWeight="SemiBold"
                               Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10">
                        <Border x:Name="OptionIntroductionCard" IsVisible="False"
                                CornerRadius="8" Padding="12"
                                Background="{DynamicResource SukiCardBackground}"
                                BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="OptionIntroductionTitle" Text="Task description"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SukiLowText}" />
                                <mdxaml:MarkdownScrollViewer x:Name="OptionIntroduction"
                                                             VerticalScrollBarVisibility="Disabled"
                                                             HorizontalScrollBarVisibility="Disabled"
                                                             EnableVirtualization="False">
                                    <mdxaml:MarkdownScrollViewer.Engine>
                                        <extensions:MarkdownExtension />
                                    </mdxaml:MarkdownScrollViewer.Engine>
                                    <mdxaml:MarkdownScrollViewer.Plugins>
                                        <StaticResource ResourceKey="MdXamlPlugin" />
                                    </mdxaml:MarkdownScrollViewer.Plugins>
                                    <mdxaml:MarkdownScrollViewer.Styles>
                                        <StyleInclude Source="avares://MFAAvalonia.Core/Assets/Style/MdXamlDocStyle.axaml" />
                                    </mdxaml:MarkdownScrollViewer.Styles>
                                </mdxaml:MarkdownScrollViewer>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12" Background="{DynamicResource SukiCardBackground}"
                                BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="1">
                            <StackPanel x:Name="MobileOptionPanel" Spacing="8" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>

        <Button Grid.Row="2" Height="52" Margin="0,10,0,0" Command="{Binding ToggleCommand}"
                IsEnabled="{Binding ToggleEnable}" Background="{DynamicResource SukiPrimaryColor}"
                Foreground="White">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsRunning}">
                    <fluent:FluentIcon Icon="Play" IconSize="Size20" />
                    <TextBlock x:Name="StartTasksText" Text="Start tasks" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRunning}">
                    <fluent:FluentIcon Icon="Stop" IconSize="Size20" />
                    <TextBlock x:Name="StopTasksText" Text="Stop tasks" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Button>
    </Grid>
</UserControl>
