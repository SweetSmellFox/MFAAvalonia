<UserControl
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="MFAAvalonia.Views.UserControls.Settings.GlobalStartSettingsUserControl"
    x:DataType="settings:GlobalStartSettingsUserControlModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:helper="clr-namespace:MFAAvalonia.Helper"
    xmlns:markup="https://codewf.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:MFAAvalonia.ViewModels.UsersControls.Settings"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:extensions="clr-namespace:SukiUI.Extensions;assembly=SukiUI">
    <StackPanel Spacing="25">
        <!-- Global Enable Toggle -->
        <suki:GlassCard Padding="25">
            <DockPanel>
                <ToggleSwitch
                    Classes="Switch"
                    DockPanel.Dock="Right"
                    IsChecked="{Binding GlobalStartEnabled}"
                    VerticalAlignment="Top" />
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="启用全局配置" />
                    <TextBlock
                        Opacity="0.72"
                        TextWrapping="Wrap"
                        Text="配置多开模拟器的启动参数，一键同时启动所有实例" />
                </StackPanel>
            </DockPanel>
        </suki:GlassCard>

        <!-- Emulator List -->
        <suki:GlassCard Padding="25" IsVisible="{Binding GlobalStartEnabled}">
            <StackPanel Spacing="12">
                <DockPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="多开模拟器列表"
                        VerticalAlignment="Center" />
                    <Button
                        DockPanel.Dock="Right"
                        Command="{Binding AddEmulatorCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <fluent:FluentIcon Icon="Add" IconSize="Size16" />
                            <TextBlock Text="添加" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding EmulatorEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settings:EmulatorStartEntry">
                            <Border
                                BorderBrush="{DynamicResource SukiLightBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,4"
                                Padding="12">
                                <StackPanel Spacing="8">
                                    <DockPanel>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            DockPanel.Dock="Right"
                                            Command="{Binding RemoveCommand}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Padding="4">
                                            <fluent:FluentIcon Icon="Delete" IconSize="Size16" />
                                        </Button>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBox
                                            DockPanel.Dock="Right"
                                            Text="{Binding SoftwarePath}"
                                            Width="280"
                                            Watermark="模拟器可执行文件路径">
                                            <TextBox.InnerRightContent>
                                                <Button
                                                    Command="{Binding BrowsePathCommand}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    Height="20"
                                                    Padding="-4,0,0,0"
                                                    Width="30">
                                                    <fluent:FluentIcon Icon="FolderArrowLeft" IconSize="Size16" />
                                                </Button>
                                            </TextBox.InnerRightContent>
                                        </TextBox>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="路径" />
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBox
                                            DockPanel.Dock="Right"
                                            Text="{Binding EmulatorConfig}"
                                            Width="280"
                                            Watermark="如 -v 0" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="参数" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </suki:GlassCard>

        <!-- Wait Time & Start All -->
        <suki:GlassCard Padding="25" IsVisible="{Binding GlobalStartEnabled}">
            <StackPanel Spacing="12">
                <DockPanel>
                    <NumericUpDown
                        DockPanel.Dock="Right"
                        Value="{Binding GlobalWaitSoftwareTime}"
                        Width="215" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="等待模拟器启动时间（秒）" />
                    </StackPanel>
                </DockPanel>
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding StartAllEmulatorsCommand}"
                    Classes="Primary">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fluent:FluentIcon Icon="Play" IconSize="Size16" />
                        <TextBlock FontSize="14" Text="一键启动所有模拟器并执行任务" />
                    </StackPanel>
                </Button>
                <TextBlock
                    Opacity="0.72"
                    TextWrapping="Wrap"
                    Text="同时启动列表中的所有模拟器，等待指定时间后依次执行各实例任务。定时器触发时也会执行此操作。" />
            </StackPanel>
        </suki:GlassCard>
    </StackPanel>
</UserControl>
